{
  "name": "phianosheets",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "build:pages": "vite build --mode pages",
    "check:pages": "npm run build:pages && node scripts/check-pages-build.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "soundfont-player": "^0.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0"
  }
}
